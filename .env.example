# Serveur
PORT=3000
DATABASE_PATH=./data/bot.sqlite
BUSINESS_TZ=Europe/Paris
# Intervalle du contrôle des réponses Google (30 min / 24 h) et des publications différées
SCHEDULER_INTERVAL_MS=60000
DEFAULT_DAILY_LIMIT=10

# WhatsApp Cloud API
META_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
TEMPLATE_NAME=alerte_avis
TEMPLATE_LANG=fr

# Google Business Profile : api (OAuth) ou webhook (Make / Zapier)
GOOGLE_PROVIDER=api
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Jeton de secours si l'établissement n'a pas le sien dans google_tokens
GOOGLE_REFRESH_TOKEN=

# Secours quand GOOGLE_PROVIDER=webhook : publication déléguée
PUBLISH_WEBHOOK_URL=

# Secrets optionnels des entrées alternatives. S'ils sont vides, les routes restent ouvertes.
PUBSUB_PUSH_SECRET=
NEW_REVIEW_SECRET=

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1024
